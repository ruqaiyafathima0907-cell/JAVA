class Employee {
    int id;
    String name;
    double basicSalary;
    double hra;
    double da;
    double grossSalary;

    void displayDetails(){
        System.out.println("Employee Id: "+id);
        System.out.println("Employee Name: "+name);
        System.out.println("Employee Salary: "+basicSalary);
        System.out.println("hra: "+hra);
         System.out.println("da: "+da);
          System.out.println("Gross Salary: "+grossSalary);
    }
    void grossCalculation(){
        hra=basicSalary*0.2;
        da=basicSalary*0.1;
        grossSalary=basicSalary+hra+da;
    }
}
    
class Main {
    public static void main(String[] args){
        Employee e1=new Employee();
        e1.id=78;
        e1.name="Maya";
        e1.basicSalary=98000;
        e1.grossCalculation();
        e1.displayDetails();
       Employee e2=new Employee();
        e2.id=79;
        e2.name="Zayn";
        e2.basicSalary=95000;
        e2.grossCalculation();
        e2.displayDetails();
    }
}
