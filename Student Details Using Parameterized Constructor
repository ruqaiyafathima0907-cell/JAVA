class Student{
    int rollNo;
    String name;
    Student(int r, String n){
        rollNo=r;
        name=n;
    }
    void display(){
        System.out.println(rollNo+"  "+name);
    }
}
class Main {
public static void main(String[] agrs){
Student s1=new Student(101,"Maya");
Student s2=new Student(102,"Ayaan");
s1.display();
s2.display();
}
}
