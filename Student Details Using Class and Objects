class Student {
    int rollNo;
    String name;
    double marks;
    void displayDetails(){
        System.out.println("Roll no: "+rollNo);
        System.out.println("Name: "+name);
        System.out.println("Marks: "+marks);
    }
}
    
class Main {
    public static void main(String[] args){
        Student s1=new Student();
        s1.rollNo=78;
        s1.name="Maya";
        s1.marks=98;
        s1.displayDetails();
        Student s2=new Student();
        s2.rollNo=79;
        s2.name="Zayn";
        s2.marks=95;
        s2.displayDetails();
    }
}
